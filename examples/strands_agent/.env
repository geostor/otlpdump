# OpenTelemetry auto-configuration (read by opentelemetry-instrument)
OTEL_SERVICE_NAME=strands-agent
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Strands instruments threading itself
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=threading

# Use the latest GenAI semantic conventions for Strands spans
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
